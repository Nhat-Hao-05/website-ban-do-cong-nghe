@model MyEStore.Models.HangHoaVM

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="row">
        <!-- Hình sản phẩm -->
        <div class="col-md-6 text-center">
            @{
                string imgSrc = !string.IsNullOrEmpty(Model.Hinh) && (Model.Hinh.StartsWith("http://") || Model.Hinh.StartsWith("https://"))
                    ? Model.Hinh
                    : Url.Content("~/Hinh/HangHoa/" + Model.Hinh);
            }
            <img src="@imgSrc"
                 alt="@Model.TenHh"
                 class="img-fluid rounded shadow-sm"
                 style="max-height:400px;"
                 onerror="this.onerror=null; this.src='https://placehold.co/500x500?text=VH-EStore';" />
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">
            <h2 class="text-primary fw-bold">@Model.TenHh</h2>
            <p class="fs-5 text-danger fw-bold">
                Giá: @Model.DonGia.ToString("N0") VNĐ
            </p>
            <p><strong>Mô tả:</strong> @Model.MoTa</p>

            <!-- Form mua hàng -->
            <form asp-action="AddToCart" asp-controller="Cart" asp-route-id="@Model.MaHh" method="post" class="mt-3">
                <div class="d-flex align-items-center mb-3">
                    <label class="me-2 fw-bold">Số lượng:</label>
                    <input type="number" name="qty" value="1" min="1"
                           class="form-control w-25 me-3 text-center" />
                </div>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                </button>
            </form>

            <!-- Nút quay lại -->
            <div class="mt-4">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>

@section MetaTags {
    <!-- SEO meta -->
    <meta name="description" content="@Model.MoTa" />
    <meta name="keywords" content="@Model.TenHh, MyEStore, mua sắm trực tuyến" />

    <!-- Open Graph meta -->
    <meta property="og:title" content="@Model.TenHh" />
    <meta property="og:description" content="@Model.MoTa" />
    <meta property="og:url" content="@Url.Action("Details", "Products", new { ten = Model.TenHh.Replace(" ", "-"), id = Model.MaHh }, protocol: "https")" />
    <meta property="og:image" content="https://mystore.com/Hinh/HangHoa/@Model.Hinh" />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="MyEStore" />
}
