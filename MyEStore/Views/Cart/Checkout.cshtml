@model IEnumerable<MyEStore.Models.CartItem>
@{
    ViewData["Title"] = "Thanh toán đơn hàng - VH-EStore";
    var tongTien = Model.Sum(p => p.SoLuong * p.DonGia);

    // 🎯 ĐÃ SỬA MỐC FREESHIP LÊN 20 TRIỆU (20.000.000)
    var phiVanChuyen = tongTien >= 20000000 ? 0 : 30000;
    var thanhTien = tongTien + phiVanChuyen;
}

<div class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-shield-check me-2"></i>Thanh Toán Đơn Hàng</h2>
        <p class="text-muted">Vui lòng kiểm tra thông tin giao hàng và chọn phương thức thanh toán phù hợp</p>
    </div>

    <form asp-controller="Cart" asp-action="Checkout" method="post">
        <div class="row g-4">
            <!-- CỘT BÊN TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN -->
            <div class="col-lg-7">

                <!-- 1. Thông tin người nhận -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>1. Thông tin giao hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Họ và tên *</label>
                                <input type="text" name="HoTen" class="form-control" placeholder="Nguyễn Văn A" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại *</label>
                                <input type="tel" name="DienThoai" class="form-control" placeholder="0901234567" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Địa chỉ nhận hàng *</label>
                                <input type="text" name="DiaChi" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Khu vực giao hàng *</label>
                                <select name="KhuVuc" id="khuVucSelect" class="form-select" onchange="updateShippingFee()">
                                    <option value="NoiThanh" data-fee="30000">Nội thành TP.HCM (Giao 2 - 4 giờ)</option>
                                    <option value="NgoaiThanh" data-fee="45000">Ngoại thành & Các tỉnh (Giao 2 - 3 ngày)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Ghi chú đơn hàng (Tùy chọn)</label>
                                <textarea name="GhiChu" class="form-control" rows="2" placeholder="Ghi chú về thời gian giao, chỉ dẫn địa chỉ..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Phương thức thanh toán -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>2. Chọn phương thức thanh toán</h5>
                    </div>
                    <div class="card-body">

                        <!-- Option 1: COD -->
                        <div class="border rounded p-3 mb-3 payment-option active">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentCOD" value="COD" checked onchange="togglePaymentDetails()">
                                <label class="form-check-label d-flex align-items-center fw-bold" for="paymentCOD">
                                    <i class="bi bi-cash-stack text-success fs-4 me-3"></i>
                                    Thanh toán khi nhận hàng (COD)
                                </label>
                            </div>
                            <div class="mt-2 text-muted small ps-4">
                                Bạn sẽ thanh toán bằng tiền mặt cho nhân viên giao hàng sau khi đã mở thùng kiểm tra sản phẩm.
                            </div>
                        </div>

                        <!-- Option 2: VietQR / Chuyển khoản -->
                        <div class="border rounded p-3 mb-3 payment-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentBank" value="BankTransfer" onchange="togglePaymentDetails()">
                                <label class="form-check-label d-flex align-items-center fw-bold" for="paymentBank">
                                    <i class="bi bi-qr-code-scan text-primary fs-4 me-3"></i>
                                    Chuyển khoản Ngân hàng (Quét mã VietQR)
                                </label>
                            </div>
                            <div id="bankDetails" class="mt-3 p-3 bg-light rounded text-center border d-none">
                                <p class="small fw-bold text-danger mb-2">Quét mã QR dưới đây bằng ứng dụng Ngân hàng để thanh toán:</p>
                                <img id="imgVietQR" src="https://img.vietqr.io/image/MB-0975701357-compact2.png?amount=@thanhTien&addInfo=VHSTORE%20THANHTOAN" class="img-fluid rounded border shadow-sm mb-2" style="max-width: 220px;" alt="VietQR Payment" />
                                <div class="text-start small text-dark mt-2">
                                    <div>• <strong>Ngân hàng:</strong> MB Bank</div>
                                    <div>• <strong>Số tài khoản:</strong> <span class="text-danger fw-bold">0975 701 357</span></div>
                                    <div>• <strong>Chủ tài khoản:</strong> VH ESTORE</div>
                                    <div>• <strong>Số tiền:</strong> <span id="lblQrSoTien" class="text-success fw-bold">@thanhTien.ToString("#,##0") VNĐ</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Option 3: Ví MoMo / VNPay -->
                        <div class="border rounded p-3 mb-3 payment-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentEWallet" value="EWallet" onchange="togglePaymentDetails()">
                                <label class="form-check-label d-flex align-items-center fw-bold" for="paymentEWallet">
                                    <i class="bi bi-wallet2 text-danger fs-4 me-3"></i>
                                    Ví điện tử (MoMo / VNPay / ZaloPay)
                                </label>
                            </div>
                            <div id="ewalletDetails" class="mt-2 text-muted small ps-4 d-none">
                                Hệ thống sẽ chuyển hướng bạn đến cổng thanh toán MoMo / VNPay an toàn để quét mã thanh toán.
                            </div>
                        </div>

                        <!-- Option 4: Thẻ tín dụng / Trả góp -->
                        <div class="border rounded p-3 payment-option">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMethod" id="paymentInstallment" value="Installment" onchange="togglePaymentDetails()">
                                <label class="form-check-label d-flex align-items-center fw-bold" for="paymentInstallment">
                                    <i class="bi bi-credit-card text-warning fs-4 me-3"></i>
                                    Trả góp Lãi suất 0% / Thẻ tín dụng (VISA, Mastercard)
                                </label>
                            </div>
                            <div id="installmentDetails" class="mt-2 text-muted small ps-4 d-none">
                                Hỗ trợ trả góp 0% qua thẻ tín dụng của 25+ ngân hàng liên kết.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- CỘT BÊN PHẢI: TÓM TẮT ĐƠN HÀNG -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bag-check-fill text-warning me-2"></i>Tóm tắt đơn hàng (@Model.Sum(p => p.SoLuong))</h5>
                    </div>
                    <div class="card-body">
                        <!-- Danh sách sản phẩm -->
                        <div class="mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var item in Model)
                            {
                                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                                    <img src="@(!string.IsNullOrEmpty(item.Hinh) && item.Hinh.StartsWith("http") ? item.Hinh : Url.Content("~/Hinh/HangHoa/" + item.Hinh))"
                                         class="rounded border me-3" style="width: 60px; height: 60px; object-fit: cover;"
                                         onerror="this.onerror=null; this.src='https://placehold.co/100x100?text=VH';" />
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-semibold text-truncate" style="max-width: 180px;">@item.TenHh</h6>
                                        <small class="text-muted">Số lượng: @item.SoLuong</small>
                                    </div>
                                    <div class="fw-bold text-danger fs-6">
                                        @((item.SoLuong * item.DonGia).ToString("#,##0")) đ
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Tính tiền -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-semibold">@tongTien.ToString("#,##0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-semibold" id="lblPhiVanChuyen">
                                @(phiVanChuyen == 0 ? "Miễn phí" : phiVanChuyen.ToString("#,##0") + " VNĐ")
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold text-dark">Tổng thanh toán:</span>
                            <span class="fs-4 fw-bold text-danger" id="lblThanhTien">@thanhTien.ToString("#,##0") VNĐ</span>
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold py-3 text-dark shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i>XÁC NHẬN ĐẶT HÀNG
                        </button>

                        <div class="text-center mt-3 small text-muted">
                            <i class="bi bi-shield-lock me-1"></i> Thông tin của bạn luôn được bảo mật an toàn 100%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function togglePaymentDetails() {
            document.getElementById('bankDetails').classList.add('d-none');
            document.getElementById('ewalletDetails').classList.add('d-none');
            document.getElementById('installmentDetails').classList.add('d-none');

            if (document.getElementById('paymentBank').checked) {
                document.getElementById('bankDetails').classList.remove('d-none');
            } else if (document.getElementById('paymentEWallet').checked) {
                document.getElementById('ewalletDetails').classList.remove('d-none');
            } else if (document.getElementById('paymentInstallment').checked) {
                document.getElementById('installmentDetails').classList.remove('d-none');
            }
        }

        function updateShippingFee() {
            var tongTien = @tongTien;
            var phiVanChuyen = 0;

            // 🎯 ĐÃ SỬA MỐC FREESHIP THÀNH 20.000.000 (20 TRIỆU)
            if (tongTien < 20000000) {
                var selectedKhuVuc = document.getElementById('khuVucSelect').value;
                if (selectedKhuVuc === 'NgoaiThanh') {
                    phiVanChuyen = 45000;
                } else {
                    phiVanChuyen = 30000;
                }
            } else {
                phiVanChuyen = 0; // Đơn >= 20.000.000đ được FREESHIP
            }

            var thanhTien = tongTien + phiVanChuyen;

            // 1. Cập nhật con số hiển thị phí ship và tổng tiền
            document.getElementById('lblPhiVanChuyen').innerText = phiVanChuyen === 0 ? "Miễn phí" : phiVanChuyen.toLocaleString('vi-VN') + " VNĐ";
            document.getElementById('lblThanhTien').innerText = thanhTien.toLocaleString('vi-VN') + " VNĐ";

            // 2. Cập nhật lại QR VietQR và số tiền trong khung chuyển khoản ngân hàng
            var qrImg = document.getElementById('imgVietQR');
            if (qrImg) {
                qrImg.src = `https://img.vietqr.io/image/MB-0975701357-compact2.png?amount=${thanhTien}&addInfo=VHSTORE%20THANHTOAN`;
            }
            var qrSoTien = document.getElementById('lblQrSoTien');
            if (qrSoTien) {
                qrSoTien.innerText = thanhTien.toLocaleString('vi-VN') + " VNĐ";
            }
        }

        // Tự động chạy hàm updateShippingFee khi vừa tải trang để cập nhật đúng phí ngay từ đầu
        document.addEventListener("DOMContentLoaded", function() {
            updateShippingFee();
        });
    </script>
}