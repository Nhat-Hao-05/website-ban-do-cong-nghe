@model IEnumerable<MyEStore.Models.CartItem>

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show my-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>@TempData["Error"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <h1 class="mb-4 text-primary"><i class="bi bi-cart-fill"></i> Giỏ hàng của bạn</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Hình</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh"
                                     class="img-thumbnail" style="width:100px; height:auto;" />
                            </td>
                            <td>
                                <strong>@item.TenHh</strong>
                            </td>
                            <td class="text-danger fw-bold">
                                @string.Format("{0:N0}", item.DonGia) VNĐ
                            </td>
                            <td>
                                <form asp-action="UpdateCart" method="post" class="d-flex align-items-center">
                                    <input type="hidden" name="id" value="@item.MaHh" />
                                    <input type="number" name="qty" value="@item.SoLuong" min="1"
                                           class="form-control form-control-sm me-2 text-center" style="width: 70px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="fw-bold">
                                @string.Format("{0:N0}", item.DonGia * item.SoLuong) VNĐ
                            </td>
                            <td>
                                <a asp-action="RemoveCart" asp-route-id="@item.MaHh"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-secondary">
                        <td colspan="4" class="text-end fw-bold">Tổng tiền:</td>
                        <td colspan="2" class="fw-bold text-danger">
                            @string.Format("{0:N0}", Model.Sum(item => item.DonGia * item.SoLuong)) VNĐ
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-end">
                            <a asp-controller="Cart" asp-action="Checkout" class="btn btn-success btn-lg me-2">
                                <i class="bi bi-credit-card"></i> Thanh toán
                            </a>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-plus-circle"></i> Thêm sản phẩm khác
                            </a>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center p-5">
            <i class="bi bi-cart-x display-4"></i>
            <h4 class="mt-3">Giỏ hàng đang trống</h4>
            <p>Hãy thêm sản phẩm để bắt đầu mua sắm.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Xem sản phẩm
            </a>
        </div>
    }
</div>
