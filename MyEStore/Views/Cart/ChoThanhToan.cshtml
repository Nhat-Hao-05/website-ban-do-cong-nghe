@model MyEStore.Entities.HoaDon
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var tongTien = Model.ChiTietHds?.Sum(ct => ct.SoLuong * ct.DonGia) ?? 0;
    var phiVanChuyen = tongTien >= 2000000 ? 0 : 30000;
    var thanhTien = tongTien + phiVanChuyen;
}

<div class="container my-5" style="max-width: 650px;">
    <div class="card shadow border-0 rounded-4 p-4 text-center">

        <h4 class="fw-bold text-primary mb-1">
            <i class="bi bi-qr-code-scan me-2"></i>THANH TOÁN ĐƠN HÀNG #@Model.MaHd
        </h4>
        <p class="text-muted small">Vui lòng quét mã bên dưới để hoàn tất giao dịch</p>

        <!-- HIỂN THỊ MÃ QR TỰ ĐỘNG -->
        <div class="position-relative d-inline-block my-3 mx-auto p-3 bg-white rounded border shadow-sm">
            <img src="https://img.vietqr.io/image/MB-0975701357-compact2.png?amount=@thanhTien&addInfo=VHSTORE%20HD@Model.MaHd"
                 class="img-fluid rounded" style="max-width: 230px;" alt="QR Payment" />
        </div>

        <div class="alert alert-warning d-flex align-items-center justify-content-center gap-2 py-2 fs-6">
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
            <span id="statusText">Đang chờ tín hiệu thanh toán từ Ngân hàng / Ví...</span>
        </div>

        <!-- NÚT GIẢ LẬP KHI DEMO (Đề phòng không muốn chờ 5s) -->
        <div class="mt-2">
            <button onclick="hoanTatThanhToan()" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i>[DEMO] Giả lập đã quét mã thành công
            </button>
            <small class="text-muted d-block mt-2">
                Hệ thống sẽ tự động xác nhận sau <b id="countdown" class="text-danger">5</b> giây...
            </small>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // 1. Tự động đếm ngược 5 giây rồi nhảy sang trang Success
        let seconds = 5;
        let timer = setInterval(function() {
            seconds--;
            document.getElementById("countdown").innerText = seconds;

            if (seconds <= 0) {
                clearInterval(timer);
                hoanTatThanhToan();
            }
        }, 1000);

        // 2. Hàm giả lập chuyển trang
        function hoanTatThanhToan() {
            document.getElementById("statusText").innerHTML = "<b class='text-success'>Đã nhận được tiền! Đang chuyển hướng...</b>";
            setTimeout(function() {
                window.location.href = "/Cart/Success/@Model.MaHd";
            }, 800);
        }
    </script>
}