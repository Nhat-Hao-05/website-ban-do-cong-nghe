@model IEnumerable<MyEStore.Entities.HoaDon>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container my-5" style="min-height: 400px;">
    <h3 class="fw-bold text-primary mb-4">
        <i class="bi bi-bag-check-fill me-2"></i>Đơn hàng của tôi
    </h3>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm rounded-3">
            <i class="bi bi-info-circle me-2"></i>Bạn chưa có đơn hàng nào! Hãy đặt mua sản phẩm ngay nhé.
        </div>
    }
    else
    {
        <div class="accordion" id="accordionOrders">
            @foreach (var order in Model)
            {
                var tongTien = order.ChiTietHds?.Sum(ct => ct.SoLuong * ct.DonGia) ?? 0;

                <div class="card border shadow-sm mb-3 rounded-3">
                    <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-primary fs-6">Mã đơn: #@order.MaHd</span>
                            <span class="text-muted ms-3 small">
                                <i class="bi bi-calendar3 me-1"></i>@order.NgayDat.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                        <div>
                            <span class="badge bg-success me-2">Đặt thành công</span>
                            <span class="fw-bold text-danger fs-6">@tongTien.ToString("#,##0") đ</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="mb-2 small"><strong><i class="bi bi-geo-alt me-1"></i>Thông tin & Ghi chú:</strong> @order.GhiChu</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @if (order.ChiTietHds != null)
                                    {
                                        @foreach (var item in order.ChiTietHds)
                                        {
                                            <tr>
                                                <td><strong>@(item.MaHhNavigation?.TenHh ?? $"Mã SP: {item.MaHh}")</strong></td>
                                                <td class="text-center">@item.SoLuong</td>
                                                <td class="text-end">@item.DonGia.ToString("#,##0") đ</td>
                                                <td class="text-end fw-bold">@((item.SoLuong * item.DonGia).ToString("#,##0")) đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>