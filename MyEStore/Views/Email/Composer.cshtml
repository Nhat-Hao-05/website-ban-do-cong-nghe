@{
    ViewBag.Title = "Tạo & Gửi email marketing";
}

<h2>Tạo & Gửi email marketing</h2>

<form id="emailComposer" class="email-composer">
    <div class="row">
        <div class="col">
            <label>Audience (Mailchimp List ID)</label>
            <input type="text" name="audienceId" class="form-control" placeholder="vd: a1b2c3d4e5" required />
        </div>
        <div class="col">
            <label>From name</label>
            <input type="text" name="fromName" class="form-control" placeholder="Tên hiển thị" required />
        </div>
        <div class="col">
            <label>Reply-to email</label>
            <input type="email" name="replyTo" class="form-control" placeholder="you@domain.com" required />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            <label>Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="Tiêu đề email" required />
        </div>
        <div class="col">
            <label>Preview text</label>
            <input type="text" name="previewText" class="form-control" placeholder="Mô tả ngắn hiển thị trong inbox" />
        </div>
    </div>

    <div class="mt-3">
        <label>Hero image URL</label>
        <input type="url" name="heroImage" class="form-control" placeholder="https://.../banner.jpg" />
    </div>

    <div class="mt-3">
        <label>Nội dung HTML</label>
        <textarea name="htmlContent" class="form-control" rows="12" placeholder="<h1>Xin chào</h1><p>Nội dung email...</p><a href='https://your-site.com'>Xem thêm</a>" required></textarea>
        <small>Tip: chèn link trở về website, thêm CTA rõ ràng.</small>
    </div>

    <div class="mt-3">
        <button type="button" class="btn btn-primary" onclick="previewEmail()">Xem trước</button>
        <button type="submit" class="btn btn-success">Gửi email</button>
    </div>
</form>

<!-- Preview -->
<div id="emailPreview" class="mt-4" style="display:none;">
    <h3>Preview</h3>
    <div class="card p-3">
        <img id="previewHero" src="" alt="" style="max-width:100%; height:auto; display:none;" />
        <div id="previewHtml"></div>
    </div>
</div>

<style>
    .email-composer .row { display:flex; gap:16px; }
    .email-composer .row .col { flex:1; min-width:240px; }
    .email-composer label { font-weight:600; margin-bottom:6px; }
    .email-composer .form-control { padding:10px; border:1px solid #ddd; border-radius:6px; }
    .btn { padding:10px 16px; border-radius:6px; }
</style>

<script>
    function previewEmail(){
        const form = document.getElementById('emailComposer');
        const hero = form.heroImage.value.trim();
        const html = form.htmlContent.value;

        const heroEl = document.getElementById('previewHero');
        const htmlEl = document.getElementById('previewHtml');

        if (hero) { heroEl.src = hero; heroEl.style.display = 'block'; } else { heroEl.style.display = 'none'; }
        htmlEl.innerHTML = html;

        document.getElementById('emailPreview').style.display = 'block';
    }

    document.getElementById('emailComposer').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;

        const payload = {
            audienceId: form.audienceId.value.trim(),
            fromName: form.fromName.value.trim(),
            replyTo: form.replyTo.value.trim(),
            subject: form.subject.value.trim(),
            previewText: form.previewText.value.trim(),
            heroImage: form.heroImage.value.trim(),
            htmlContent: form.htmlContent.value
        };

        const res = await fetch('/email/send-mailchimp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.status === 'success') {
            alert('Email đã được gửi thành công!');
        } else {
            alert('Gửi thất bại: ' + (data.message || 'Có lỗi xảy ra'));
        }
    });
</script>
