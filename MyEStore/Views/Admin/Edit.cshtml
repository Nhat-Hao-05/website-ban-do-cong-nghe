@model MyEStore.Entities.HangHoa
@{
    Layout = "_LayoutAdmin";
    ViewBag.Title = "Chỉnh sửa sản phẩm";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Sửa hàng hóa: @Model.TenHh</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="MaHh" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            <label class="control-label">Tên hàng hóa</label>
                            <input asp-for="TenHh" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Đơn giá</label>
                            <input asp-for="DonGia" type="number" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Loại sản phẩm</label>
                            <select asp-for="MaLoai" class="form-control"
                                    asp-items="@(new SelectList(ViewBag.Loai, "MaLoai", "TenLoai"))">
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">Mô tả</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4 text-center">
                        <div class="form-group mb-3">
                            <label class="control-label d-block">Hình ảnh hiện tại</label>

                            @* --- XỬ LÝ ẢNH LINK ONLINE HOẶC FILE CỤC BỘ --- *@
                            @if (!string.IsNullOrEmpty(Model.Hinh) && (Model.Hinh.StartsWith("http://") || Model.Hinh.StartsWith("https://")))
                            {
                                <img src="@Model.Hinh" id="preview" class="img-thumbnail mb-2" style="max-height: 200px; width: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <img src="~/Hinh/HangHoa/@Model.Hinh" id="preview" class="img-thumbnail mb-2" style="max-height: 200px; width: 100%; object-fit: cover;" />
                            }

                            <input type="file" name="HinhUpload" class="form-control" onchange="previewImage(this)" />
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="ManageProducts" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#preview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}