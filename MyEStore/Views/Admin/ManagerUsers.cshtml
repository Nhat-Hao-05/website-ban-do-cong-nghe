@model IEnumerable<MyEStore.Entities.KhachHang>
@{
    Layout = "_LayoutAdmin";
}

<h2 class="mt-4">Quản lý người dùng</h2>

<table class="table table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Mã KH</th>
            <th>Họ Tên</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaKh</td>
                <td>@item.HoTen</td>
                <td>@item.Email</td>
                <td>
                    <span class="badge @(item.HieuLuc ? "bg-success" : "bg-danger")">
                        @(item.HieuLuc ? "Đang hoạt động" : "Đã khóa")
                    </span>
                </td>
                <td>
                   
                    <form asp-action="ToggleUserStatus" asp-route-id="@item.MaKh" method="post">
                        <button class="btn btn-sm btn-outline-warning">Đổi trạng thái</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>