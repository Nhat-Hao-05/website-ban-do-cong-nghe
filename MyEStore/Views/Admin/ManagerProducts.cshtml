@model IEnumerable<MyEStore.Entities.HangHoa>
@{
    Layout = "_LayoutAdmin";
    ViewBag.Title = "Quản lý sản phẩm";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách hàng hóa</h6>
        <a asp-action="CreateProducts" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>Hình</th>
                        <th>Tên hàng hóa</th>
                        <th>Đơn giá</th>
                        <th>Loại</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <img src="~/Hinh/HangHoa/@item.Hinh" style="width:50px; height:50px; object-fit:cover;" class="rounded" />
                                </td>
                                <td>@item.TenHh</td>
                                <td>@item.DonGia.ToString("#,##0") đ</td>
                                <td>@item.MaLoaiNavigation?.TenLoai</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-primary btn-sm">Sửa</a>
                                    <a asp-action="DeleteProduct" asp-route-id="@item.MaHh" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>