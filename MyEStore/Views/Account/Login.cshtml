@{
    ViewBag.Title = "Đăng nhập";
}

<!-- Import Google Fonts dành cho phong cách Sang Trọng -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --luxury-dark: #0f172a; /* Đen xanh đêm */
        --luxury-blue-start: #1e40af; /* Xanh Royal sang trọng */
        --luxury-blue-end: #0f172a;
        --luxury-gold: #c5a880;
        --luxury-bg: #f8fafc;
        --luxury-text-sub: #64748b;
    }

    body {
        background-color: var(--luxury-bg);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .luxury-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .luxury-card {
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        border-radius: 24px !important;
        background: #ffffff;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.08) !important;
        overflow: hidden;
        width: 100%;
        max-width: 980px;
    }

    /* Bảng bên trái: Giới thiệu tính năng (Tương tự hình mẫu) */
    .luxury-brand-panel {
        background: linear-gradient(145deg, var(--luxury-blue-start) 0%, var(--luxury-blue-end) 100%);
        color: #ffffff;
        padding: 3.5rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
    }

    .brand-icon-box {
        width: 56px;
        height: 56px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.25rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.5px;
        color: #ffffff;
    }

    .brand-desc {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        font-weight: 400;
    }

    .brand-features {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .brand-features li {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            margin-bottom: 1.1rem;
            color: rgba(255, 255, 255, 0.95);
            font-weight: 500;
        }

            .brand-features li i {
                font-size: 1.1rem;
                color: #93c5fd; /* Icon tích xanh nhạt nổi bật */
            }

    /* Bảng bên phải: Form Đăng nhập */
    .luxury-form-panel {
        padding: 3.5rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .luxury-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.85rem;
        color: var(--luxury-dark);
        margin-bottom: 0.5rem;
    }

    .luxury-subtitle {
        font-size: 0.875rem;
        color: var(--luxury-text-sub);
        margin-bottom: 2rem;
    }

    /* Input styling */
    .input-icon-wrapper {
        position: relative;
    }

        .input-icon-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 1.1rem;
            transition: color 0.2s ease;
            z-index: 5;
        }

    .form-control-luxury {
        border: 1px solid #e2e8f0;
        border-radius: 12px !important;
        padding: 0.85rem 1rem 0.85rem 3rem !important;
        font-size: 0.95rem;
        background-color: #f8fafc;
        transition: all 0.25s ease;
    }

        .form-control-luxury:focus {
            background-color: #ffffff;
            border-color: var(--luxury-blue-start);
            box-shadow: 0 0 0 4px rgba(30, 64, 175, 0.1);
            outline: none;
        }

            .form-control-luxury:focus + i {
                color: var(--luxury-blue-start);
            }

    /* Button styling */
    .btn-luxury {
        background-color: var(--luxury-dark);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 0.9rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 0.825rem;
        transition: all 0.3s ease;
    }

        .btn-luxury:hover {
            background-color: var(--luxury-blue-start);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(30, 64, 175, 0.2);
        }

    .luxury-link {
        color: var(--luxury-dark);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

        .luxury-link:hover {
            color: var(--luxury-blue-start);
            text-decoration: underline;
        }
</style>

<div class="container luxury-wrapper">
    <div class="card luxury-card">
        <div class="row g-0">

            <!-- 1. BẢNG BÊN TRÁI: HIỂN THỊ TÍNH NĂNG (Giống ảnh mẫu) -->
            <div class="col-lg-6 d-none d-lg-block luxury-brand-panel">
                <div class="brand-icon-box">
                    <i class="bi bi-bag"></i>
                </div>

                <h1 class="brand-title">VH-EStore</h1>
                <p class="brand-desc">
                    Mua sắm nhanh chóng, thanh toán an toàn qua VNPay và theo dõi đơn hàng dễ dàng.
                </p>

                <ul class="brand-features">
                    <li>
                        <i class="bi bi-check-lg"></i>
                        <span>Thanh toán VNPay bảo mật</span>
                    </li>
                    <li>
                        <i class="bi bi-check-lg"></i>
                        <span>Theo dõi đơn hàng thời gian thực</span>
                    </li>
                    <li>
                        <i class="bi bi-check-lg"></i>
                        <span>Ưu đãi thành viên</span>
                    </li>
                </ul>
            </div>

            <!-- 2. BẢNG BÊN PHẢI: FORM ĐĂNG NHẬP -->
            <div class="col-lg-6 luxury-form-panel">
                <div class="text-center text-lg-start">
                    <h2 class="luxury-title">Đăng Nhập</h2>
                    <p class="luxury-subtitle">Chào mừng bạn quay trở lại trải nghiệm mua sắm</p>
                </div>

                <!-- Dùng asp-route-returnurl để truyền tham số ReturnUrl về lại Controller -->
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewBag.ReturnUrl" method="post">

                    <!-- ASP.NET Core sẽ tự động tạo AntiForgeryToken khi dùng Tag Helper -->
                    <!-- 1. Email (Khớp với tham số: string email) -->
                    <div class="mb-3">
                        <label class="form-label input-label">Địa chỉ Email</label>
                        <div class="input-icon-wrapper">
                            <input name="email" type="email" class="form-control form-control-luxury" placeholder="name@example.com" required />
                            <i class="bi bi-envelope"></i>
                        </div>
                    </div>

                    <!-- 2. Mật khẩu (Khớp với tham số: string matKhau) -->
                    <div class="mb-3">
                        <label class="form-label input-label">Mật khẩu</label>
                        <div class="input-icon-wrapper">
                            <input name="matKhau" type="password" class="form-control form-control-luxury" placeholder="••••••••" required />
                            <i class="bi bi-lock"></i>
                        </div>
                    </div>

                    <!-- Quên mật khẩu -->
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div></div>
                        <a href="#forgot-password" class="luxury-link small">Quên mật khẩu?</a>
                    </div>

                    <!-- Nút Đăng nhập -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-luxury-submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                        </button>
                    </div>

                    <!-- Hiển thị thông báo lỗi từ Controller (ViewBag.Error) -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger border-0 mt-3 text-center mb-0" style="background-color: #fef2f2; color: #991b1b; border-radius: 10px; font-size: 0.875rem;">
                            <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
                        </div>
                    }
                </form>

                <!-- Footer Đăng ký -->
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="mb-0 text-muted" style="font-size: 0.875rem;">
                        Chưa có tài khoản?
                        <a asp-controller="Account" asp-action="Register" class="luxury-link ms-1">Đăng ký ngay</a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>