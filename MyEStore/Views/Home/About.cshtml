@{
    ViewData["Title"] = "Giới thiệu - VH-EStore";
}

<div class="container my-5">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-warning text-dark px-3 py-2 fs-6 mb-2">Thế Giới Công Nghệ</span>
            <h1 class="fw-bold text-primary display-5 mb-3">Chào mừng bạn đến với VH-EStore</h1>
            <p class="lead text-secondary">
                **VH-EStore** là hệ thống bán lẻ các sản phẩm công nghệ chính hãng hàng đầu, cung cấp các dòng Điện thoại, Laptop, Đồng hồ thông minh và Phụ kiện cao cấp từ các thương hiệu uy tín thế giới.
            </p>
            <p class="text-muted">
                Với phương châm **"Khách hàng là trung tâm"**, chúng tôi không chỉ bán sản phẩm mà còn mang lại trải nghiệm mua sắm an tâm, tiện lợi và dịch vụ hậu mãi vượt trội cho mọi người dùng.
            </p>
        </div>
        <div class="col-lg-6 text-center">
            <img src="https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=700" class="img-fluid rounded-4 shadow-lg" alt="VH-EStore Technology">
        </div>
    </div>

    <!-- Core Values -->
    <div class="row text-center mb-5">
        <h2 class="fw-bold mb-4">Tại sao chọn VH-EStore?</h2>
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-shield-check text-success display-4 mb-3"></i>
                    <h5 class="fw-bold">100% Chính Hãng</h5>
                    <p class="text-muted small">Cam kết sản phẩm mới 100%, nguyên seal, đầy đủ hóa đơn và chứng nhận.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-truck text-primary display-4 mb-3"></i>
                    <h5 class="fw-bold">Giao Hàng Tốc Độ</h5>
                    <p class="text-muted small">Giao hàng toàn quốc nhanh chóng, đóng gói cẩn thận, đảm bảo an toàn.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-tags text-warning display-4 mb-3"></i>
                    <h5 class="fw-bold">Giá Cạnh Tranh</h5>
                    <p class="text-muted small">Luôn mang đến mức giá ưu đãi cùng nhiều chương trình khuyến mãi hấp dẫn.</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-headset text-danger display-4 mb-3"></i>
                    <h5 class="fw-bold">Hỗ Trợ 24/7</h5>
                    <p class="text-muted small">Đội ngũ tư vấn kỹ thuật tận tình, sẵn sàng giải đáp mọi thắc mắc của bạn.</p>
                </div>
            </div>
        </div>
    </div>
</div>