@{
    ViewData["Title"] = "Dịch vụ & Bảo hành - VH-EStore";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">Chính Sách Dịch Vụ & Bảo Hành</h1>
        <p class="text-muted">An tâm trải nghiệm công nghệ cùng chính sách hậu mãi chu đáo tại VH-EStore</p>
    </div>

    <!-- Cam kết bảo hành -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="p-4 border rounded-3 bg-light text-center h-100">
                <div class="badge bg-danger rounded-circle p-3 mb-3 fs-3"><i class="bi bi-arrow-repeat"></i></div>
                <h4 class="fw-bold">1 Đổi 1 Trong 30 Ngày</h4>
                <p class="text-muted">Áp dụng cho tất cả sản phẩm gặp lỗi từ nhà sản xuất trong 30 ngày đầu sử dụng.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded-3 bg-light text-center h-100">
                <div class="badge bg-success rounded-circle p-3 mb-3 fs-3"><i class="bi bi-award"></i></div>
                <h4 class="fw-bold">Bảo Hành 12 - 24 Tháng</h4>
                <p class="text-muted">Bảo hành chính hãng theo tiêu chuẩn của các nhà sản xuất Apple, Samsung, Asus, Dell...</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border rounded-3 bg-light text-center h-100">
                <div class="badge bg-info text-white rounded-circle p-3 mb-3 fs-3"><i class="bi bi-tools"></i></div>
                <h4 class="fw-bold">Hỗ Trợ Kỹ Thuật Trọn Đời</h4>
                <p class="text-muted">Hỗ trợ cài đặt phần mềm, vệ sinh máy và tư vấn kỹ thuật miễn phí trong suốt quá trình sử dụng.</p>
            </div>
        </div>
    </div>

    <!-- Quy trình bảo hành -->
    <div class="bg-white p-4 rounded-3 shadow-sm border mb-5">
        <h3 class="fw-bold mb-4 text-center"><i class="bi bi-gear-wide-connected text-primary me-2"></i>Quy Trình Tiếp Nhận Bảo Hành</h3>
        <div class="row text-center">
            <div class="col-md-3 mb-3">
                <div class="p-3">
                    <span class="badge bg-primary rounded-pill mb-2 px-3 py-2 fs-6">Bước 1</span>
                    <h6 class="fw-bold">Tiếp Nhận Máy</h6>
                    <p class="small text-muted">Khách hàng mang thiết bị đến cửa hàng hoặc gửi chuyển phát nhanh.</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3">
                    <span class="badge bg-primary rounded-pill mb-2 px-3 py-2 fs-6">Bước 2</span>
                    <h6 class="fw-bold">Kiểm Tra Lỗi</h6>
                    <p class="small text-muted">Kỹ thuật viên kiểm tra tổng thể và xác định nguyên nhân sự cố trong 24h.</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3">
                    <span class="badge bg-primary rounded-pill mb-2 px-3 py-2 fs-6">Bước 3</span>
                    <h6 class="fw-bold">Sửa Chữa / Đổi Mới</h6>
                    <p class="small text-muted">Xử lý bảo hành theo quy định của hãng (Sửa chữa linh kiện hoặc đổi mới).</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3">
                    <span class="badge bg-primary rounded-pill mb-2 px-3 py-2 fs-6">Bước 4</span>
                    <h6 class="fw-bold">Bàn Giao Thiết Bị</h6>
                    <p class="small text-muted">Khách hàng kiểm tra máy và nhận lại thiết bị cùng phiếu bảo hành.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin liên hệ hỗ trợ -->
    <div class="alert alert-warning border-0 p-4 text-center">
        <h5 class="fw-bold mb-2"><i class="bi bi-telephone-outbound me-2"></i>Cần Hỗ Trợ Bảo Hành Gấp?</h5>
        <p class="mb-2">Vui lòng liên hệ Hotline kỹ thuật hoặc gửi Email cho chúng tôi để được xử lý nhanh nhất:</p>
        <p class="mb-0 fs-5 fw-bold text-dark">
            📞 Hotline: <span class="text-danger">0975 701 357</span> | ✉️ Email: <span class="text-primary">VHStore@gmail.com</span>
        </p>
    </div>
</div>